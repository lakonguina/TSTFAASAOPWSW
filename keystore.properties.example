# Copie ce fichier en `keystore.properties` (gitignoré) et remplis-le.
# Le vrai keystore.properties + release.keystore ne doivent JAMAIS être commités.
# Pour GitHub Actions : mettre le keystore (base64) et ces valeurs en secrets.
storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=forcelist
keyPassword=CHANGE_ME
