{
  "manifest_version": 2,
  "name": "hider",
  "version": "1.0.2",
  "browser_specific_settings": { "gecko": { "id": "hider@tstfaasaopwsw" } },
  "permissions": ["<all_urls>", "nativeMessaging"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
