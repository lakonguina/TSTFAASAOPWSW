<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Mise à jour auto depuis GitHub : télécharger l'APK puis l'installer. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Device Owner qui doit pouvoir lister et bloquer n'importe quelle app :
         sans ça, Android 11+ ne laisse voir qu'une poignée de packages. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Forcelist">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Navigateur embarqué. Déclaré comme gestionnaire web ; PolicyManager en fait
             le navigateur par défaut non contournable (addPersistentPreferredActivity). -->
        <activity
            android:name=".BrowserActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".TickReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.khazaddum.forcelist.TICK" />
            </intent-filter>
        </receiver>

        <!-- Contrôle réactif des installations. PACKAGE_ADDED est exempté de la
             restriction Android 8+ sur les broadcasts implicites : la déclaration en
             manifeste est donc bien réveillée. -->
        <receiver
            android:name=".InstallGuard"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Résultat d'installation de la mise à jour (PackageInstaller.commit). -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

        <!-- Pare-feu réseau (VPN local, filtrage DNS). Le Device Owner le pose en
             always-on ; BIND_VPN_SERVICE restreint qui peut le lier. -->
        <service
            android:name=".FilterVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>

</manifest>
